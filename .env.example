# Executive Assistant Configuration

# Set to true to run in offline demo mode using realistic mocked work data.
# Set to false to attempt real execution of Swytchcode integrations.
DEMO_MODE=true

# Port for the local dashboard server
PORT=3000

# Optional Google Gemini API Key for AI Reasoning
# If empty, the application will use a custom rule-based semantic reasoning engine.
GEMINI_API_KEY=
